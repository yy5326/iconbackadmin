		if ( roundRequestVO != null ) {
			if ( "0".equals(startRequestVO.getRcpKind()) ) {
				// 아이콘접수일 경우 받는분
				sb.append("예약자 : "+startRequestVO.getCusReNm()+" \n");
			} else if ( "1".equals(startRequestVO.getRcpKind()) ) {
