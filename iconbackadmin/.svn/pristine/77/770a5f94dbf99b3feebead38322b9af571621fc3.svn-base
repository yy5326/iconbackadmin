package com.golf.talk.message;

import java.util.List;

import com.golf.talk.vo.SendRequestVO;

public class ReceiptCancelMessage {
	
	public static String getForUser(SendRequestVO sendRequestVO) {
		if ( "0".equals(sendRequestVO.getRcpKind()) ) {
			// 관리자 접수, 편도 
			return makeForUserByIcon(sendRequestVO);
		} else if ( "1".equals(sendRequestVO.getRcpKind()) ) {
			// 챗봇 접수, 편도 
			return makeForUserByChat(sendRequestVO);
		} else if ( "2".equals(sendRequestVO.getRcpKind()) ) {
			// 어플 접수, 편도 
			return makeForUserByIcon(sendRequestVO);
		} else {
			// 구분값 없을시
			return makeForUserByIcon(sendRequestVO);
		}
	}
	
	public static String makeForUserByIcon(SendRequestVO sendRequestVO) {
		StringBuffer sb = new StringBuffer();
		sb.append("[아이콘] 접수 취소 완료 \n\n");

		//sb.append("안녕하세요. "+sendRequestVO.getReceiver()+" 고객님 골프택배 "+sendRequestVO.getRcpNumber()+" 접수가 정상 취소되었습니다.\n\n");
		sb.append("안녕하세요. "+sendRequestVO.getCusReNm()+" 고객님 골프택배 "+sendRequestVO.getRcpNumber()+" 접수가 정상 취소되었습니다.\n\n");

		sb.append("다음에 다시 이용 부탁드립니다. \n");
		sb.append("고객님께 만족을 드릴 수 있는 아이콘이 되겠습니다. 감사합니다.\n\n");

		sb.append("계좌이체를 통한 환불에는 환불까지 1~2일 정도 소요됩니다.(영업일기준)\n\n");

		sb.append("추가 문의사항이 있으시면 고객센터 1544-3044로 문의부탁드립니다.\n");
		return sb.toString();
	}
	
	public static String makeForUserByChat(SendRequestVO sendRequestVO) {
		StringBuffer sb = new StringBuffer();
		sb.append("[아이콘] 접수 취소 완료 \n\n");

		sb.append("안녕하세요. "+sendRequestVO.getReceiver()+" 고객님 골프택배 "+sendRequestVO.getRcpNumber()+" 접수가 정상 취소되었습니다.\n\n");

		sb.append("다음에 다시 이용 부탁드립니다. \n");
		sb.append("고객님께 만족을 드릴 수 있는 아이콘이 되겠습니다. 감사합니다.\n\n");

		sb.append("챗봇 결제가 아닌 일반결제로 진행하신 경우 환불이 1~2일 정도 소요됩니다.\n\n");

		sb.append("추가 문의사항이 있으시면 고객센터 1544-3044로 문의부탁드립니다.\n");
		return sb.toString();
	}
	
	public static String getForUserRound(List<SendRequestVO> list) {
		if ( "0".equals(list.get(0).getRcpKind()) ) {
			// 관리자 접수, 왕복
			return makeForUserRoundByIcon(list);
		} else if ( "1".equals(list.get(0).getRcpKind()) ) {
			// 챗봇 접수, 왕복 
			return makeForUserRoundByChat(list);
		} else if ( "2".equals(list.get(0).getRcpKind()) ) {
			// 어플 접수, 왕복
			return makeForUserRoundByIcon(list);
		} else {
			// 구분값 없을시
			return makeForUserRoundByIcon(list);
		}
	}
	
