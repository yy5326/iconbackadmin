			}
			sb.append("접수번호 : "+startRequestVO.getRcpNumber()+","+roundRequestVO.getRcpNumber()+" \n");
			sb.append("연락처 : "+startRequestVO.getReceiverNum()+"\n");
			sb.append("골프백수량 : "+startRequestVO.getPdCnt()+"\n");
			sb.append("라운딩일정 : "+gameDt+"\n");
			sb.append("픽업희망일 : "+startRequestVO.getPicReqDt()+"\n");
			sb.append("총합계 : "+(startRequestVO.getPdPay()+roundRequestVO.getPdPay())+"원 \n");
			sb.append("(추가할증 : "+(startRequestVO.getPdEtcPay()+roundRequestVO.getPdEtcPay())+"원) \n\n");
		} else {
			if ( "0".equals(startRequestVO.getRcpKind()) ) {
				// 아이콘접수일 경우 받는분
				sb.append("예약자 : "+startRequestVO.getCusReNm()+" \n");
			} else if ( "1".equals(startRequestVO.getRcpKind()) ) {
				// 챗봇접수일 경우 접수자
				sb.append("예약자 : "+startRequestVO.getReceiver()+" \n");
			} else {
				sb.append("예약자 : "+startRequestVO.getReceiver()+" \n");
			}
			sb.append("접수번호 : "+startRequestVO.getRcpNumber()+" \n");
			sb.append("연락처 : "+startRequestVO.getReceiverNum()+"\n");
			sb.append("골프백수량 : "+startRequestVO.getPdCnt()+"\n");
			sb.append("라운딩일정 : "+gameDt+"\n");
			sb.append("픽업희망일 : "+startRequestVO.getPicReqDt()+"\n");
			sb.append("총합계 : "+startRequestVO.getPdPay()+"원 \n");
			sb.append("(추가할증 : "+(startRequestVO.getPdEtcPay())+"원) \n\n");
		}

		sb.append("결제취소완료 !\n\n");
		return sb.toString();
	}

