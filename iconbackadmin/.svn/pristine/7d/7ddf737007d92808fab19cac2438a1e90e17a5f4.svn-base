package com.golf.model;

/**
 * 파일 메타 - blueimp 드래그 앤 드롭 파일 업로드 모델
 * @author wimy
 *
 */
public class FileMeta implements GeneralModel {
	

	/**
	 * 
	 */
	private static final long serialVersionUID = -5354389480755716180L;

	private long fileSeq;
	
	private String physicalName;
	
	private String fileName;
	
	private String fileSize;
	
	private String contentType;
	
	private byte[] bytes;

	
	
	String[] fileSeqs;
	String[] physicalNames;
	String[] fileNames;
	String[] contentTypes;
	String[] fileSizes;
	
	
	
	
	public long getFileSeq() {
		return fileSeq;
	}

	public void setFileSeq(long fileSeq) {
		this.fileSeq = fileSeq;
	}

	public String getPhysicalName() {
		return physicalName;
	}

	public void setPhysicalName(String physicalName) {
		this.physicalName = physicalName;
	}

	public String getFileName() {
		return fileName;
	}

	public void setFileName(String fileName) {
		this.fileName = fileName;
	}

	public String getFileSize() {
		return fileSize;
	}

	public void setFileSize(String fileSize) {
		this.fileSize = fileSize;
	}

	public String getContentType() {
		return contentType;
	}

	public void setContentType(String contentType) {
		this.contentType = contentType;
	}

	public byte[] getBytes() {
		return bytes;
	}

	public void setBytes(byte[] bytes) {
		this.bytes = bytes;
	}

	
	/**
	 * dnd 파일 업로드 처리용
	 * @return
	 */
	public String[] getFileSeqs() {
		return fileSeqs;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @param fileSeqs
	 */
	public void setFileSeqs(String[] fileSeqs) {
		this.fileSeqs = fileSeqs;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @return
	 */
	public String[] getPhysicalNames() {
		return physicalNames;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @param physicalNames
	 */
	public void setPhysicalNames(String[] physicalNames) {
		this.physicalNames = physicalNames;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @return
	 */
	public String[] getFileNames() {
		return fileNames;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @param fileNames
	 */
	public void setFileNames(String[] fileNames) {
		this.fileNames = fileNames;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @return
	 */
	public String[] getContentTypes() {
		return contentTypes;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @param contentTypes
	 */
	public void setContentTypes(String[] contentTypes) {
		this.contentTypes = contentTypes;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @return
	 */
	public String[] getFileSizes() {
		return fileSizes;
	}

	/**
	 * dnd 파일 업로드 처리용
	 * @param fileSizes
	 */
	public void setFileSizes(String[] fileSizes) {
		this.fileSizes = fileSizes;
	}
	
	
	
	
	
}