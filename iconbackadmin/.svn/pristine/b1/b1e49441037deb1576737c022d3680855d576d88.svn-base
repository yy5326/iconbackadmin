package com.golf.service.impl;

import java.util.List;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.golf.service.model.GolfInfVO;

/**
 * 골프장 관리
 * @author khs
 *
 */
@Service("GolfService")
public class GolfInfServiceImpl extends BaseServiceImpl {
	private static final Logger logger = LoggerFactory.getLogger(GolfInfServiceImpl.class);

	/**
	 * 골프장 등록
	 */
	@Transactional
	public void insertGolf(GolfInfVO mstVO) throws Exception {
		//접수 등록
		getDAO().insert("golfInf.insertGolfInf", mstVO);
	}

	/**
	 * 골프장 수정
	 */
	@Transactional
	public void updateGolf(GolfInfVO mstVO) throws Exception {
		//접수 수정
		getDAO().insert("golfInf.updateGolfInf", mstVO);
	}
	/**
	 * 골프장 삭제
	 */
	@Transactional
	public void deleteGolf(GolfInfVO mstVO) throws Exception {
		//접수 등록
		getDAO().insert("golfInf.deleteGolfInf", mstVO);
	}

	/**
	 * 골프장 리스트 검색
	 */
	@SuppressWarnings("unchecked")
	public List<GolfInfVO> selectReceiptGolfList(GolfInfVO golfVO) throws Exception {

		//골프장 리스트
		return (List<GolfInfVO>)getDAO().selectList("golfReceipt.selectGolfInf", golfVO);
	}
}
