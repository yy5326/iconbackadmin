<%@ page language="java" contentType="text/html;" pageEncoding="EUC-KR"%>
<%@ include file="/WEB-INF/jsp/common/tags.jsp"%>
<%@ include file="/WEB-INF/include/admin_header_html.jsp"%>

<div class="pop layer_pag">
	<div class="pop_tit pop_title">골프장 상호 검색</div>

	<form id="form" action="./receiptGolfLayer.do?${pageContext.request.queryString }">
	<input type="hidden" id="cpage" name="cpage" value="1">
	<input type="hidden" id="type1" name="type1" value="${search.type1}">
	<div class="cons layer_cons">
			<div class="pop_ser_box">
				<p>
					<tt:select list="${type2 }" id="type2" name="type2" listKey="value" listValue="text" selected="${search.type2 }" />
					<span>
						<input id="searchWord" name="searchWord" type="text"  maxlength="20" value="${search.searchWord}" class="search_word"><a href="javascript:doSearch();" class="search_btn btn_ser">검색</a>
					</span>
				</p>
			</div>

			<div class="pop_scroll">
				<table class="pop_list pop_list1">
					<colgroup>
						<!-- <col width="19%">
						<col width="8%">
						<col width="14%">
						<col width="18%">
						<col width="18%">
						<col width="18%"> -->
						<col width="24%">
						<col width="32%">
						<col width="16%">
						<col width="24%">
					</colgroup>
					<thead>
						<tr>
							<th>골프장명</th>
							<th>지역</th>
							<th>연락처</th>
							<th>지정영업소</th>
							<!-- <th>지정영업소2</th>
							<th>지정영업소3</th> -->
						</tr>
					</thead>

					<tbody>
<c:if test="${!empty list }">
	<c:forEach items="${list}" var="g">
						<tr style="cursor: pointer;">
							<td>${g.golfName}<input type="hidden" id="fee1" value="${g.fee1}" />
							<input type="hidden" id="fee2" value="${g.fee2}" />
							<input type="hidden" id="fee3" value="${g.fee3}" />
							<input type="hidden" id="fee4" value="${g.fee4}" />
							<input type="hidden" id="fee5" value="${g.fee5}" />
							<input type="hidden" id="fee6" value="${g.fee6}" />
							<input type="hidden" id="fee7" value="${g.fee7}" />
							<input type="hidden" id="fee8" value="${g.fee8}" />
							<input type="hidden" id="fee9" value="${g.fee9}" />
							<input type="hidden" id="fee10" value="${g.fee10}" />
							<input type="hidden" id="fee11" value="${g.fee11}" />
							<input type="hidden" id="fee12" value="${g.fee12}" /></td>
							<td class="ht">${g.golfSeq}</td>
							<td class="ht">${g.zipCode}</td>
							<td class="ht">${g.golfAddr1}</td>
							<td class="ht">${g.golfAddr2}</td>
							<td>${g.golfAddr1}</td>
							<td>${fn:length(g.golfTelnum) < 1 ? g.golfTelnum2 : g.golfTelnum}</td>
							<%-- <td>${g.golfTypeCd eq '0' ? '챔피언' : g.golfTypeCd eq '1' ? '레귤러' : '이그젝티브'}</td> --%>
							<td role="picOffice1">${g.picOffice1}</td>
							<td role="picOffice1" class="ht">${g.picOfficeCode1}</td>
							<%-- <td role="picOffice2">${g.picOffice2}</td>
							<td role="picOffice2" class="ht">${g.picOfficeCode2}</td>
							<td role="picOffice3">${g.picOffice3}</td>
							<td role="picOffice3" class="ht">${g.picOfficeCode3}</td> --%>
						</tr>
	</c:forEach>
</c:if>

<c:if test="${empty list }">
						<tr>
							<td colspan="7"><s:message code="common.noData" /></td>
						</tr>
</c:if>
					</tbody>
				</table>
			</div>
		</div>

		<%@ include file="/WEB-INF/jsp/common/inc-paging-admin.jsp"%>
	</form>
  </div>
</html>

<script>
	$(document).ready(function(){

		//검색화면으로 포커싱
		$("#searchWord").focus();
		//숨김 데이터 처리
		$(".ht").hide();
		//골프장 지정 선택
		$("tr > td").click(function(){
			var targetElement = $.trim('${search.type1}');
			var targetAddrElement = targetElement.replace("golfSearch","zip");
			var trElement = $(this).parent().children();
			/*
			var roleVal = ($(this).is("[role]") && $.trim($(this).text()) != "") ? $(this).text() : trElement.filter("[role=picOffice1]:first").text();
			var roleCode = ($(this).is("[role]") && $.trim($(this).text()) != "") ? $(this).next().text() : trElement.filter("[role=picOffice1]:last").text();

			if(!$(this).is("[role]") || $.trim($(this).text()) == ""){
				if(!confirm("["+trElement.eq(0).text()+"] 지정영업소1을 선택하시겠습니까?")) return;
			}
			*/
			var roleVal = trElement.filter("[role=picOffice1]:first").text();
			var roleCode = trElement.filter("[role=picOffice1]:last").text();
			parent.$("input[role="+targetElement+"]").each(function(idx){
				//if(idx == 0) $(this).val(golfNm).prop("readonly",true);
				if(idx == 0) $(this).val(trElement.eq(0).text());
				else if(idx == 1) $(this).val(trElement.eq(1).text());
				else if(idx == 2) $(this).val(roleVal).prop("readonly",true);
				else $(this).val(roleCode);
			});
			parent.$("input[role="+targetAddrElement+"]").each(function(idx){
				if(idx == 0) $(this).val(trElement.eq(2).text());
				else if(idx == 1) $(this).val(trElement.eq(3).text());
				else $(this).val(trElement.eq(4).text());
			});
			if(targetElement == "golfSearch2") parent.$("#golfSeq").val(trElement.eq(1).text());
			parent.setIconFee(targetElement, 
					[
						[$(this).parent().find('#fee1').val(),$(this).parent().find('#fee2').val(),$(this).parent().find('#fee3').val()],
						[$(this).parent().find('#fee4').val(),$(this).parent().find('#fee5').val(),$(this).parent().find('#fee6').val()],
						[$(this).parent().find('#fee7').val(),$(this).parent().find('#fee8').val(),$(this).parent().find('#fee9').val()],
						[$(this).parent().find('#fee10').val(),$(this).parent().find('#fee11').val(),$(this).parent().find('#fee12').val()]
					]);
			parent.searchIsl();
			parent.$.colorbox.close();
		})
	});

	//검색
	function doSearch() {
		$("#form").submit();
	}
</script>