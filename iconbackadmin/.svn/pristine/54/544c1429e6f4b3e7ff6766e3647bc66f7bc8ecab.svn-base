</body>
<script type="text/javascript">

	$(document).ready(function(){
		//등록
		$("#add").click(function(){
			if (!confirm("접수하시겠습니까?"))
				return;
			//$("form").submit();
			JSON.parse(replaceNewLineChars('${jsonVO}'))
			JSON.parse(replaceNewLineChars('${jsonList}'))
			var jsonData = $.extend({}, new Object(JSON.parse(replaceNewLineChars('${jsonVO}'))), new Object(JSON.parse(replaceNewLineChars('${jsonList}'))));

			$.ajax({
				type : "POST",
				async: false ,
				url : "receiptProc.do",
				data : JSON.stringify(jsonData),
				dataType : "json",
				contentType: "application/json",
				success : function(data) {
					if(data == "true"){
						alert("접수가 정상적으로 완료되었습니다.");
						location.href="./receiptWrite.do";
					}
		        },error : function(xhr, status, error) {
					alert("에러발생  " + xhr.status + "관리자에게 문의 바랍니다.");
				}
			});
		});

	});

	//개행 제거
	function replaceNewLineChars(value){
		if (value != null && value != ""){
			return value.replace(/\r/gi, '\\r').replace(/\n/gi, '\\n').replace(/\t/gi, '\\t').replace(/\f/gi, '\\f')
			//return value.replace(/\r/gi, '\\r').replace(/\n/gi, '\\n');
		}else{
			return value;
		}
	}


</script>
