<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cbLog">
  <resultMap id="BaseResultMap" type="com.golf.chat.vo.CbLogVO">
    <result column="HIS_CB_SEQ" jdbcType="INTEGER" property="hisCbSeq" />
    <result column="USER_ID" jdbcType="VARCHAR" property="userId" />
    <result column="INTENT" jdbcType="VARCHAR" property="intent" />
    <result column="UTTERANCE" jdbcType="VARCHAR" property="utterance" />
    <result column="ENTITY_ENTRY" jdbcType="VARCHAR" property="entityEntry" />
    <result column="PLUSFRIEND_USER_KEY" jdbcType="VARCHAR" property="plusfriendUserKey" />
    <result column="BOT_USER_KEY" jdbcType="VARCHAR" property="botUserKey" />
    <result column="REG_DATE" jdbcType="TIMESTAMP" property="regDate" />
  </resultMap>

  <insert id="insertKakaoCbLog" parameterType="com.golf.chat.vo.CbLogVO">
    INSERT INTO GOLF_HISTORY_CB
    <trim prefix="(" suffix=")" suffixOverrides=",">
        HIS_CB_SEQ,
      <if test="userId != null">
        USER_ID,
      </if>
      <if test="intent != null">
        INTENT,
      </if>
      <if test="utterance != null">
        UTTERANCE,
      </if>
      <if test="entityEntry != null">
        ENTITY_ENTRY,
      </if>
      <if test="plusfriendUserKey != null">
        PLUSFRIEND_USER_KEY,
      </if>
      <if test="botUserKey != null">
        BOT_USER_KEY,
      </if>
        REG_DATE
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      	(SELECT NEXTVAL(HIS_CB_SEQ)),
      <if test="userId != null">
        #{userId,jdbcType=VARCHAR},
      </if>
      <if test="intent != null">
        #{intent,jdbcType=VARCHAR},
      </if>
      <if test="utterance != null">
        #{utterance,jdbcType=VARCHAR},
      </if>
      <if test="entityEntry != null">
        #{entityEntry,jdbcType=VARCHAR},
      </if>
      <if test="plusfriendUserKey != null">
        #{plusfriendUserKey,jdbcType=VARCHAR},
      </if>
      <if test="botUserKey != null">
        #{botUserKey,jdbcType=VARCHAR},
      </if>
		NOW()
    </trim>
  </insert>
</mapper>