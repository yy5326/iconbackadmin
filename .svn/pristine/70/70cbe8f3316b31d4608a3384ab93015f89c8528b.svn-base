package com.golf.service.model;

import java.util.Date;

import com.golf.model.GeneralModel;

public class MainVO implements GeneralModel {

	private static final long serialVersionUID = 5835188151523792726L;
	
	private int scIdx;
	private String pdBarcode;
	private String scGubun;
	private String scNm;
	private String scId;
	private String scTelnum;
	private Date scTime;  
	private Date scRegdt;  
	private int corpNo;
	private int corpPhone;
	
	
	
	public int getScIdx() {
		return scIdx;
	}
	public void setScIdx(int scIdx) {
		this.scIdx = scIdx;
	}
	public String getPdBarcode() {
		return pdBarcode;
	}
	public void setPdBarcode(String pdBarcode) {
		this.pdBarcode = pdBarcode;
	}
	public String getScGubun() {
		return scGubun;
	}
	public void setScGubun(String scGubun) {
		this.scGubun = scGubun;
	}
	public String getScNm() {
		return scNm;
	}
	public void setScNm(String scNm) {
		this.scNm = scNm;
	}
	public String getScId() {
		return scId;
	}
	public void setScId(String scId) {
		this.scId = scId;
	}
	public String getScTelnum() {
		return scTelnum;
	}
	public void setScTelnum(String scTelnum) {
		this.scTelnum = scTelnum;
	}
	public Date getScTime() {
		return scTime;
	}
	public void setScTime(Date scTime) {
		this.scTime = scTime;
	}
	public Date getScRegdt() {
		return scRegdt;
	}
	public void setScRegdt(Date scRegdt) {
		this.scRegdt = scRegdt;
	}
	public int getCorpNo() {
		return corpNo;
	}
	public void setCorpNo(int corpNo) {
		this.corpNo = corpNo;
	}
	public int getCorpPhone() {
		return corpPhone;
	}
	public void setCorpPhone(int corpPhone) {
		this.corpPhone = corpPhone;
	}
	
	
	
}
