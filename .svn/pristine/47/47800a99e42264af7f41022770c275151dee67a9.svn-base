<%@ page language="java" contentType="text/html;" pageEncoding="EUC-KR"%>
<%@ include file="/WEB-INF/jsp/common/tags.jsp"%>
<%@ include file="/WEB-INF/include/admin_header_html.jsp"%>

			<div class="pop_scroll">
				<table class="pop_list pop_list1">
					<colgroup>
						<col width="22%">
						<col width="63%">
						<col width="15%">
					</colgroup>
					<thead>
						<tr>
							<th>영업소명</th>
							<th>영업소 주소</th>
							<th>우편번호</th>
						</tr>
					</thead>

					<tbody>
<c:choose>
	<c:when test="${!empty searchMapList}">
		<c:forEach var="m" items="${searchMapList}">					
							<tr class="officeList" style="cursor: pointer;" id="${m.picOfficeCode}">
								<td>${m.picOffice}</td>
								<td>${m.picOfficeAddr}</td>
								<td>${m.picOfficeZipCode}</td>
							</tr>
		</c:forEach>
	</c:when>						
	<c:otherwise>
							<tr>						
								<td colspan="3">조회내용이 없습니다.</td>
							</tr>
	</c:otherwise>
</c:choose>
					</tbody>
				</table>
			</div>


<script type="text/javascript">

$(document).ready(function(){
	$(".officeList").click(function(){
		var tr = $(this);
		var td = tr.children();
		parent.office($(this).attr('id'), td.eq(0).text());
	});
});
</script>