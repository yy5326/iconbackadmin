	/**
	 * 접수상태명
	 * @return
	 */
	public String getRcpInfStatName() {
		if (this.getRcpInfStat() == null)
			return "";
		else if (this.getRcpInfStat().equals("0"))
			return "골프접수";
		else if (this.getRcpInfStat().equals("1"))
			return "픽업요청";
		else if (this.getRcpInfStat().equals("2"))
			return "택배접수";
		else if (this.getRcpInfStat().equals("3"))
			return "배송완료";
		else if (this.getRcpInfStat().equals("4"))
			return "접수대기";
		else if (this.getRcpInfStat().equals("7"))
			return "골프취소";
		else if (this.getRcpInfStat().equals("8"))
			return "픽업취소";
		else if (this.getRcpInfStat().equals("9"))
			return "택배취소";
		else
			return "";
	}

	/**
	 * 품목명
	 * @return
	 */
	public String getPdNmName() {
		if (this.getPdNm() == null)
			return "";
		else if (this.getPdNm().equals("0"))
			return "골프백";
		else if (this.getPdNm().equals("1"))
			return "보스턴백";
		else if (this.getPdNm().equals("2"))
			return "기타";
		else
			return "";
	}

	/**
	 * 배송구분명
	 * @return
	 */
	public String getDelKindName() {
		if (this.getDelKind() == null)
			return "";
		else if (this.getDelKind().equals("1"))
			return "편도";
		else if (this.getDelKind().equals("2"))
			return "왕복";
		else
			return "";
	}

	/**
	 * 발송구분명
	 * @return
	 */
	public String getSrTypeName() {
		if (this.getSrType() == null)
			return "";
		else if (this.getSrType().equals("S"))
			return "왕복 1차";
		else if (this.getSrType().equals("R"))
			return "왕복 2차";
		else
			return "편도";
	}

	/**
	 * 결제상태명 (0: 입금대기, 1: 결제완료, 9: 결제취소)
	 * @return
	 */
	public String getPayStatName() {
		if (this.getPayStat() == null)
			return "";
		else if (this.getPayStat().equals("0"))
			return "결제대기";
		else if (this.getPayStat().equals("1"))
			if (this.getPayGubun().equals("0")) {
				return "일반결제";	
			}else {
				return "카카오 결제";
			}
		else if (this.getPayStat().equals("9"))
			return "결제취소";
		else
			return "";
	}
