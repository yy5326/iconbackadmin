package com.golf.chat.vo;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import io.swagger.annotations.ApiModelProperty;
import io.swagger.annotations.ApiParam;
import lombok.Data;

public @Data class CbGolfInfoVo {
	

	@ApiParam(required=true)
	@ApiModelProperty(notes = "글프장 번호")
	private String golfSeq;
	@ApiModelProperty(notes = "골프장명")
	private String golfName;
	@ApiModelProperty(notes = "골프장 연락처")
	private String golfTelnum;
	@ApiModelProperty(notes = "골프장 주소")
	private String golfAddr;
	@ApiModelProperty(notes = "접수가능/접수불가/확인필요")
	private String useYn;
	@ApiModelProperty(notes = "도서/내륙")
	private String islYn;
	@ApiModelProperty(notes = "골프장 도로명 주소")
	private String golfAddr1;
	@ApiModelProperty(notes = "골프장 상세주소")
	private String golfAddr2;
	@ApiModelProperty(notes = "골프장 우편번호")
	private String zipCode;
	
}
