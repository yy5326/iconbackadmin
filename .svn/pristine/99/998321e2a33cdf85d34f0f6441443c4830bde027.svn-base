						<tr>
							<th>연락처 <span class="red">*</span></th>
							<td>
<c:set var="cusSendTelnum" value="${fn:split(vo.cusSendTelnum,'-')}" />

								<select role="phone1" class="phone">
									<option value="010" <c:if test="${cusSendTelnum[0] eq '010' }">selected="selected"</c:if>>010</option>
									<option value="011" <c:if test="${cusSendTelnum[0] eq '011' }">selected="selected"</c:if>>011</option>
									<option value="016" <c:if test="${cusSendTelnum[0] eq '016' }">selected="selected"</c:if>>016</option>
									<option value="017" <c:if test="${cusSendTelnum[0] eq '017' }">selected="selected"</c:if>>017</option>
