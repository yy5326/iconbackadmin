	<select id="selectGolfInf" parameterType="search" resultType="com.golf.service.model.GolfInfVO">
		SELECT
			GOLF_SEQ, GOLF_NAME, GOLF_TELNUM, GOLF_TELNUM2,
			ZIP_CODE, CITY, GOLF_ADDR1, GOLF_ADDR2, ISL_YN,
			PIC_OFFICE1, PIC_OFFICE2, PIC_OFFICE3, PIC_OFFICE_CODE1,
			PIC_OFFICE_CODE2, PIC_OFFICE_CODE3, GOLF_TYPE_CD, FEE1, FEE2, FEE3, FEE4, FEE5, FEE6, FEE7, FEE8, FEE9, FEE10, FEE11, FEE12
		FROM GOLF_INF
		<include refid="whereList" />
		ORDER BY GOLF_SEQ
		<include refid="paging.bottom" />
	</select>

	<select id="selectGolfInfCount" parameterType="search" resultType="int">
		SELECT
			COUNT(*)
		FROM GOLF_INF
		<include refid="whereList" />
	</select>

	<update id="updateGolfInf" parameterType="com.golf.service.model.GolfReceiptInfVO">
		UPDATE GOLF_RECEIPT_INF
		<set>
		    MOD_DATE = NOW(),
			<if test="rtNumber != null">
				RT_NUMBER = #{rtNumber,jdbcType=VARCHAR},
			</if>
			<if test="rcpInfStat != null">
		    	RCP_INF_STAT = #{rcpInfStat,jdbcType=VARCHAR},
		    </if>
		    <if test="canReason != null">
		    	CAN_REASON = #{canReason,jdbcType=VARCHAR},
		    </if>
		    <if test="pdRecDt != null">
		    	PD_REC_DT = #{pdRecDt,jdbcType=VARCHAR},
		    </if>
		    <if test="pdPay != null and iconFee > 0">
		    	PD_PAY = #{pdPay,jdbcType=INTEGER},
		    </if>
		    <if test="pdDeliPay != null and iconFee > 0">
		    	PD_DELI_PAY = #{pdDeliPay,jdbcType=INTEGER},
		    </if>
		    <if test="iconFee != null and iconFee > 0">
		    	ICON_FEE = #{iconFee,jdbcType=INTEGER},
		    </if>
		</set>
		WHERE RCP_INF_SEQ = #{rcpInfSeq,jdbcType=INTEGER}
	</update>


	<!-- 스마트스코어 관리자에서 취소하는 경우 전체취소 -->
	<update id="cancelSmartGolfInf" parameterType="com.golf.service.model.GolfReceiptInfVO">
		UPDATE GOLF_RECEIPT_INF
		<set>
			<if test="canReason != null">
		    	CAN_REASON = #{canReason,jdbcType=VARCHAR},
		    </if>
		    MOD_DATE = NOW(),			
		    RCP_INF_STAT = #{rcpInfStat,jdbcType=VARCHAR}
		</set>
		WHERE RCP_SEQ = #{rcpSeq,jdbcType=INTEGER}
	</update>
	
	<!-- 왕복1차 배송완료시엔 왕복2차만 접수취소 -->
	<update id="cancelSmartGolfInfComplete" parameterType="com.golf.service.model.GolfReceiptInfVO">
		UPDATE GOLF_RECEIPT_INF
		<set>
			<if test="canReason != null">
		    	CAN_REASON = #{canReason,jdbcType=VARCHAR},
		    </if>
		    MOD_DATE = NOW(),			
		    RCP_INF_STAT = #{rcpInfStat,jdbcType=VARCHAR}
		</set>
		WHERE RCP_NUMBER = #{rcpNumber,jdbcType=INTEGER}
	</update>
	
		
	<select id="selectReceiptKey" parameterType="com.golf.service.model.GolfReceiptInfVO" resultType="com.golf.service.model.GolfReceiptInfVO">
		SELECT
			IFNULL((SELECT
					  RCP_INF_SEQ
			  	    FROM GOLF_RECEIPT_INF
           		    WHERE RT_NUMBER = #{rtNumber,jdbcType=VARCHAR}), 0) RCP_INF_SEQ
	</select>

	<update id="updateGolfInfScTime" parameterType="com.golf.service.model.GolfReceiptInfVO">
		UPDATE GOLF_RECEIPT_INF
	 	   SET SC_TIME = #{scTime,jdbcType=VARCHAR}
		 	 , MOD_DATE = NOW()
		  	 , RCP_INF_STAT = #{rcpInfStat,jdbcType=VARCHAR}
		 WHERE RCP_INF_SEQ = #{rcpInfSeq,jdbcType=INTEGER}
	</update>
	
	<!-- 골프택배 발송정보 접수시 키값리턴 - 키값이 auto increment가 아니여서 어쩔 수 없음  -->
	<select id="selectMaxReceiptKey" parameterType="com.golf.service.model.GolfReceiptMstVO" resultType="com.golf.service.model.GolfReceiptMstVO">
		SELECT
			MAX(RCP_SEQ) RCP_SEQ
		FROM
			GOLF_RECEIPT_MST
	</select>
	
	<!-- 골프택배 발송정보 접수 - 챗봇용  -->
