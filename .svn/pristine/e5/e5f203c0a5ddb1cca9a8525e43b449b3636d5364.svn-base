			</if>
			<if test="bostonCnt != null and bostonCnt > 0">
				#{bostonCnt,jdbcType=INTEGER},
			</if>			
			<if test="pdEtcPay != null and pdEtcPay > 0">
				#{pdEtcPay,jdbcType=INTEGER},
			</if>
			<if test="payType != null">
				#{payType,jdbcType=VARCHAR},
			</if>
			<if test="pdDosunPay != null and pdDosunPay > 0">
				#{pdDosunPay,jdbcType=INTEGER},
			</if>
			<if test="pdDeliPay != null and pdDeliPay > 0">
				#{pdDeliPay,jdbcType=INTEGER},
			</if>
			<if test="pdPay != null and pdPay > 0">
				#{pdPay,jdbcType=INTEGER},
			</if>
			<if test="pdMemo != null">
