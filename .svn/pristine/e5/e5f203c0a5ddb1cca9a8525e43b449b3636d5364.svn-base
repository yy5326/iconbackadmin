<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="golfReceipt">

	<sql id="whereList">
	     WHERE USE_YN = 'Y'

		<if test="type2 == 0 ">
	  		AND GOLF_NAME LIKE '%${searchWord}%'
		</if>
		<if test="type2 == 1 ">
		  	AND PIC_OFFICE1 LIKE '%${searchWord}%'
		</if>
		<if test="type2 == 2 ">
			AND GOLF_ADDR1 LIKE '%${searchWord}%' OR GOLF_ADDR2 LIKE '%${searchWord}%'
		</if>
	</sql>

	<!-- 골프택배 접수  -->
	<insert id="insertReceiptMst" parameterType="com.golf.service.model.GolfReceiptMstVO" >
		<selectKey keyProperty="rcpSeq" resultType="int" order="BEFORE" statementType="PREPARED">
	    	SELECT NEXT VALUE FOR RCP_SEQ
	  	</selectKey>

		INSERT INTO GOLF_RECEIPT_MST
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="rcpSeq != null">
				rcp_seq,
			</if>
			<if test="golfSeq != null">
				golf_seq,
			</if>
			<!-- <if test="rcpStat != null">
				rcp_stat,
			</if> -->
			<if test="delKind != null">
				del_kind,
			</if>
			<if test="fareType != null">
				fare_type,
			</if>
			<if test="gameDt != null">
				game_dt,
			</if>
			<if test="regUser != null">
				reg_user,
			</if>
			<if test="gameEndDt != null">
				game_end_dt
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="rcpSeq != null">
				#{rcpSeq,jdbcType=INTEGER},
			</if>
			<if test="golfSeq != null">
				#{golfSeq,jdbcType=NUMERIC},
			</if>
			<!-- <if test="rcpStat != null">
				#{rcpStat,jdbcType=VARCHAR},
			</if> -->
			<if test="delKind != null">
				#{delKind,jdbcType=VARCHAR},
			</if>
			<if test="fareType != null">
				#{fareType,jdbcType=VARCHAR},
			</if>
			<if test="gameDt != null">
				#{gameDt,jdbcType=VARCHAR},
			</if>
			<if test="regUser != null">
				#{regUser,jdbcType=VARCHAR},
			</if>
			<if test="gameEndDt != null">
				#{gameEndDt,jdbcType=VARCHAR}
			</if>
		</trim>
	</insert>

	<!-- 골프택배 발송정보 접수  -->
	<insert id="insertReceiptInf" parameterType="com.golf.service.model.GolfReceiptInfVO">
		<selectKey keyProperty="rcpInfSeq,rcpSeq,rcpNumber" resultType="com.golf.service.model.GolfReceiptInfVO" order="BEFORE" statementType="PREPARED">
			<if test="rcpInfSeq == null or rcpInfSeq == 0">
				SELECT NEXT VALUE FOR RCP_INF_SEQ as rcpInfSeq, PREVIOUS VALUE FOR RCP_SEQ AS rcpSeq, CONCAT('GF', DATE_FORMAT(NOW(), '%Y%m%d'), PREVIOUS VALUE FOR RCP_INF_SEQ) as rcpNumber
			</if>
		</selectKey>

		INSERT INTO GOLF_RECEIPT_INF
		<trim prefix="(" suffix=")" suffixOverrides=",">
				rcp_number,
			<if test="rcpInfSeq != null">
				rcp_inf_seq,
			</if>
