@charset "utf-8";

.contents .w265{width: 265px;}
.contents .w345{width: 345px;}
.contents .w410{width: 410px;}
.contents .w586{width: 586px;}
.acen{text-align: center;}
p > .red{margin: 0 3px; font-weight: 600;}
.red{color: #ff6468 !important;}

/* placeholder */
input::placeholder{color: #1d071d; opacity: 1; letter-spacing: -0.04em; font-size: 15px; /* 파이어폭스 뿌옇게 나오는 현상을 방지 css */}
input::-webkit-input-placeholder{color: #1d071d; letter-spacing: -0.04em; font-size: 15px;}
input:-ms-input-placeholder {color: #1d071d; letter-spacing: -0.04em; font-size: 15px;} /* IE */
input:-mos-input-placeholder {color: #1d071dv; letter-spacing: -0.04em; font-size: 15px;} /* Firefox */
/* login_placeholder */
.login input::placeholder{color: #afafaf; opacity: 1; letter-spacing: -0.04em; font-size: 20px; /* 파이어폭스 뿌옇게 나오는 현상을 방지 css */}
.login input::-webkit-input-placeholder{color: #afafaf; letter-spacing: -0.04em; font-size: 20px;}
.login input:-ms-input-placeholder {color: #afafaf; letter-spacing: -0.04em; font-size: 20px;} /* IE */
.login input:-mos-input-placeholder {color: #afafaf; letter-spacing: -0.04em; font-size: 20px;} /* Firefox */
/* search_word */
input.search_word::placeholder{opacity: 1; letter-spacing: -0.04em; font-size: 16px; /* 파이어폭스 뿌옇게 나오는 현상을 방지 css */} 
input.search_word::-webkit-input-placeholder{letter-spacing: -0.04em; font-size: 16px;}
input.search_word:-ms-input-placeholder {letter-spacing: -0.04em; font-size: 16px;} /* IE */
input.search_word:-mos-input-placeholder {letter-spacing: -0.04em; font-size: 16px;} /* Firefox */
.cont_layerDetail input::placeholder{font-size: 13px; /* 파이어폭스 뿌옇게 나오는 현상을 방지 css */}
.cont_layerDetail input::-webkit-input-placeholder{font-size: 13px;}
.cont_layerDetail input:-ms-input-placeholder {font-size: 13px;} /* IE */
.cont_layerDetail input:-mos-input-placeholder {font-size: 13px;} /* Firefox */

/* readyonly */
input:-moz-read-only{background: #eee;}
input:read-only{background: #eee !important;} /* Supported in Blink/WebKit/Edge without a prefix */

/* scroll */
.inqueryCont form::-webkit-scrollbar{width: 6px;} /* width */
.inqueryCont form::-webkit-scrollbar-track{box-shadow: inset 0 0 5px grey; border-radius: 10px;} /* Track */
.inqueryCont form::-webkit-scrollbar-thumb{background: #9ea2a8; border-radius: 10px;} /* Handle */


/* file */
.fileBox input[type="file"]{position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip:rect(0,0,0,0); border: 0;}
.fileBox .upload{display: inline-block; height: 38px; vertical-align:middle; line-height: 40px;}
.fileBox .fileName{width: 257px; margin-left: 6px; padding-left: 5px; border: 1px solid #ddd; background: #fff; vertical-align: middle;}
.fileBox .btn_file{width: 78px; border: 1px solid #9ea2a8; color: #1d071d; background: #f8f8f8; font-size: 16px;}

/* 달력 */
.calendar{display: inline-block; width: 25px; height: 23px; margin-left: 5px; padding: 0 !important; border: 0 !important; background: url(/common/images/ic_calendar.png) no-repeat center; vertical-align: middle;}









