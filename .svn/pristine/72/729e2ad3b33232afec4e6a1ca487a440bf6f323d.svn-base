<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd" >

<!-- 
    MyBatis 모델, 매퍼 제너레이터
 -->
<generatorConfiguration>

    <!-- jdbc 커넥터  -->
	<classPathEntry location="D:\project\golf\Golf\src\main\webapp\WEB-INF\lib\mysql-connector-java-8.0.19.jar" />
	<context id="context1" targetRuntime="MyBatis3">
		<!-- 기본 주석 금지 여부 -->
		<commentGenerator>
			<property name="suppressAllComments" value="true"/>
			<property name="suppressDate" value="true" />
		</commentGenerator>
		
		<!-- DB 접속 정보 -->
		<jdbcConnection driverClass="com.mysql.cj.jdbc.Driver" 
			connectionURL="jdbc:mysql://183.111.71.248:3306/Golf_Test?serverTimezone=UTC" 
			userId="golf_local" 
			password="Kdlab001" />
		
		<!-- DECIMAL, NUMERIC 타입 처리 -->
		<javaTypeResolver>
			<property name="forceBigDecimals" value="false"/>
		</javaTypeResolver>
        
        <!-- 자바용 모델 생성 -->
		<javaModelGenerator targetPackage="com.golf.service.model" targetProject="Golf" >
			<property name="rootClass" value="com.golf.model.GeneralModel"/>
			
			<property name="enableSubPackages" value="false" />
			<property name="trimStrings" value="true"/>
		</javaModelGenerator>
		
		<!-- 매퍼 XML 저장 위치 -->
		<sqlMapGenerator targetPackage="egovframework.sqlmap.mappers" targetProject="Golf" />	
		
		<!-- 생성할 테이블 -->
		<table tableName="GOLF_HISTORY_CB" domainObjectName="CBBO" 
			enableInsert="true"
			enableCountByExample="false" 
			enableDeleteByExample="false"
			enableSelectByExample="false"
			enableUpdateByExample="false"
			selectByExampleQueryId="false">
		</table>
		 
	</context>
	
</generatorConfiguration>