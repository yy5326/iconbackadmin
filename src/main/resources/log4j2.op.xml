<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="base">
	 <properties>
		<property name="log-path">/usr/share/tomcat/tomcat_iconbackadmin/logs/backadmin</property>
	</properties>
                  
	<!-- Appender, Layout 설정 -->
	<Appenders>
		<Console name="console" target="SYSTEM_OUT">
			<!--  [%t] -->
			<PatternLayout pattern="%d{yyyy/MM/dd HH:mm:ss} [%-5level] %logger{36}::%M - %msg%n" />
		</Console>
		<RollingFile name="file" fileName="${log-path}/log.log" filePattern="${log-path}/log_%d{yyyy-MM-dd}.log" append="true">
			<PatternLayout pattern="%d %5p [%c::%M] %m%n"/>
			<Policies>
				<!-- default : 1(일) -->
				<TimeBasedTriggeringPolicy />
				<!-- 사이즈 제한을 하고 싶을 경우 아래 속성 추가	-->
				<!-- <SizeBasedTriggeringPolicy size="10MB"/> -->
			</Policies>
		</RollingFile>
		
		<RollingFile name="fileSchedule" fileName="${log-path}/batch.log" filePattern="${log-path}/batch_%d{yyyy-MM-dd}.log" append="true">
			<PatternLayout pattern="%d %5p [%c::%M] %m%n"/>
			<Policies>
				<TimeBasedTriggeringPolicy />
			</Policies>
		</RollingFile>
		
		<!-- CMS 펌뱅킹 관련 로깅  -->
		<RollingFile name="fileCMS" fileName="${log-path}/cms.log" filePattern="${log-path}/cms_%d{yyyy-MM-dd}.log" append="true">
			<PatternLayout pattern="%d %5p [%c::%M] %m%n"/>
			<Policies>
				<TimeBasedTriggeringPolicy />
			</Policies>
		</RollingFile>
		
		<!-- CMS 펌뱅킹 수신 배치 관련 로깅  -->
		<RollingFile name="fileCMSRecvBatch" fileName="${log-path}/cms_recv.log" filePattern="${log-path}/cms_recv_%d{yyyy-MM-dd}.log" append="true">
			<PatternLayout pattern="%d %5p [%c::%M] %m%n"/>
			<Policies>
				<TimeBasedTriggeringPolicy />
			</Policies>
		</RollingFile>
	</Appenders>

	<!-- Logger 설정 -->
	<Loggers>
		<Logger name="com.base" level="DEBUG" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		<Logger name="com.golf" level="DEBUG" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		
		<!-- 스케줄(배치) 전용 로깅 -->
		<Logger name="com.golf.service.impl.ScheduleServiceImpl" level="DEBUG" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="fileSchedule"/>
		</Logger>
		
		<!-- CMS 펌뱅킹 관련 로깅 -->
		<Logger name="com.golf.service.CmsUtil" level="DEBUG" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="fileCMS"/>
		</Logger>
		
		<!-- CMS 펌뱅킹 수신 관련 로깅 -->
		<Logger name="com.golf.service.impl.ScheduleCmsServiceImpl" level="DEBUG" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="fileCMSRecvBatch"/>
		</Logger>
		
		<Logger name="org.springframework" level="INFO" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		<Logger name="egovframework" level="INFO" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		<Logger name="org.mybatis" level="INFO" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>		
		<Logger name="org.hibernate" level="INFO" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		<Logger name="jdbc" level="INFO" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		<Logger name="jdbc.resultset" level="INFO" additivity="false">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Logger>
		
		
		<Root level="DEBUG">
			<AppenderRef ref="console"/>
			<AppenderRef ref="file"/>
		</Root>
	</Loggers>
 
</Configuration>