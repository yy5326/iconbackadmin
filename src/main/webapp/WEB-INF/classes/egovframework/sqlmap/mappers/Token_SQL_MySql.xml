<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="token">
	<resultMap id="BaseResultMap" type="com.golf.talk.vo.KakaoInfoVO">
		<result column="KAKAO_INFO_SQ" jdbcType="INTEGER" property="kakaoInfoSq" />
		<result column="USER_NAME" jdbcType="VARCHAR" property="userName" />
		<result column="CLIENT_ID" jdbcType="VARCHAR" property="clientId" />
		<result column="PASSWORD" jdbcType="VARCHAR" property="password" />
		<result column="TOKEN_URL" jdbcType="VARCHAR" property="tokenUrl" />
		<result column="SEND_URL" jdbcType="VARCHAR" property="sendUrl" />	
		<result column="TOKEN" jdbcType="VARCHAR" property="token" />
		
	</resultMap>	
	
	<select id="selectByKaKaoInfo"  resultMap="BaseResultMap" parameterType="java.lang.String">
		SELECT A.KAKAO_INFO_SQ, A.USER_NAME, A.CLIENT_ID, A.PASSWORD, A.TOKEN_URL, A.SEND_URL, A.TOKEN
		  FROM KAKAO_INFO A
	</select>
	
	<update id="updateForToken" parameterType="com.golf.talk.vo.KakaoInfoVO">
		UPDATE KAKAO_INFO
		   SET REG_DATE = NOW()
		      <choose>
             	<when test="mode == 'local' ">
		     		, TEST_TOKEN = #{token}
		     	</when>
                <otherwise>
		     		, TOKEN = #{token}
                </otherwise>
		     </choose>
		 WHERE KAKAO_INFO_SQ = #{kakaoInfoSq} 
	</update>
</mapper>